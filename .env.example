# Public URL of the site, no trailing slash (http://localhost:3000 locally)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity (sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Editor token: used by the server to write orders and commission requests, and by `npm run seed`
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=

# PayFast: "sandbox" or "live"
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Resend (resend.com)
RESEND_API_KEY=
# e.g. "Lara Berge Artworks <hello@yourdomain.co.za>" on a verified domain
MAIL_FROM=
# Where new orders, commission requests and contact messages go
LARA_EMAIL=

# Vercel Cron sends this as a Bearer token to the reservation-release route
CRON_SECRET=
